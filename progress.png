        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; height: 75px; background: #f8f8f8; display: flex; justify-content: space-around; align-items: center; border-top: 1px solid #dcdcdc; }
        .nav-item { text-decoration: none; color: #888; display: flex; flex-direction: column; align-items: center; font-size: 10px; flex: 1; }
        .nav-item.active { color: #00aaff; font-weight: bold; }
    </style>
</head>
